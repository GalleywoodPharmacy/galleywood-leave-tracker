generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeaveStatus {
  pending
  approved
  denied
  cancelled
}

model User {
  id     String @id @default(cuid())
  name   String
  email  String @unique

  passwordHash String?

  isManager Boolean @default(false)

  // Annual leave allowance in hours — the only leave type this app tracks.
  allowanceAnnualHours Float @default(200)

  // When this person started (or will start). If set, their entitlement for
  // that calendar year is pro-rated based on days remaining in the year from
  // this date, and only bank holidays on/after it count against them. Left
  // null for staff whose first year predates this feature — they get a full
  // year's entitlement as before. From their second year onward, entitlement
  // is automatically full regardless of this field.
  startDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequests       LeaveRequest[]        @relation("UserLeaveRequests")
  decidedRequests     LeaveRequest[]        @relation("DecidedByUser")
  coverageAssignments CoverageAssignment[]  @relation("UserCoverage")
  coverageCreated     CoverageAssignment[]  @relation("CoverageCreatedBy")
  loginTokens         LoginToken[]
  rota                StaffRota?

  @@map("users")
}

model LeaveRequest {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  hours Float
  notes String?

  status LeaveStatus @default(pending)

  submittedAt DateTime  @default(now())
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?     @relation("DecidedByUser", fields: [decidedById], references: [id])

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model CoverageAssignment {
  id     String   @id @default(cuid())
  date   DateTime @db.Date

  userId String
  user   User @relation("UserCoverage", fields: [userId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User @relation("CoverageCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@unique([date, userId])
  @@index([date])
  @@map("coverage_assignments")
}

model ExtraClosedDate {
  date  DateTime @id @db.Date
  label String

  @@map("extra_closed_dates")
}

model LoginToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@map("login_tokens")
}

model StaffRota {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sundayHours    Float @default(0)
  mondayHours    Float @default(7.5)
  tuesdayHours   Float @default(7.5)
  wednesdayHours Float @default(7.5)
  thursdayHours  Float @default(7.5)
  fridayHours    Float @default(7.5)
  saturdayHours  Float @default(4)

  updatedAt DateTime @updatedAt

  @@map("staff_rotas")
}