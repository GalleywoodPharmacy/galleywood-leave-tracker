generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeaveStatus {
  pending
  approved
  denied
  cancelled
}

enum LeaveType {
  annual
  sick
}

// A business using the app — currently there's only ever one (Galleywood),
// but every user is now explicitly linked to one rather than the app just
// assuming "there's only ever one business" the way it did before. This is
// step one of making the app safely support more than one business later
// without a rebuild: nothing else is organization-scoped yet (that's the
// next phase — every other table and every query needs the same treatment),
// but this is the anchor everything else will hang off.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Branding — null means "use the app's default logo", so nothing changes
  // for the existing business until a logo is actually set. The app
  // doesn't read or apply this yet; this just gets the data model ready
  // for that (a later step).
  logoUrl String?

  // Which weekdays the business is open at all, independent of any one
  // staff member's own rota — replaces the app's current hardcoded
  // assumption that every business is closed on Sundays. Defaults here
  // match Galleywood's actual pattern (closed Sunday, open every other day).
  openSunday    Boolean @default(false)
  openMonday    Boolean @default(true)
  openTuesday   Boolean @default(true)
  openWednesday Boolean @default(true)
  openThursday  Boolean @default(true)
  openFriday    Boolean @default(true)
  openSaturday  Boolean @default(true)

  // Statutory annual leave entitlement, in weeks. Defaults to the UK
  // statutory minimum (5.6 weeks) — the figure currently hardcoded
  // throughout the app — but becomes a real per-business setting instead,
  // for a business with a different policy or in a different country.
  statutoryLeaveWeeks Float @default(5.6)

  // If true (Galleywood's actual current policy), bank holiday hours are
  // deducted from the statutory allowance above. Some businesses instead
  // treat bank holidays as separate paid days off that don't touch a
  // person's annual leave pot at all — set this to false for those.
  //
  // NOT yet covered by this step: a configurable bank holiday calendar
  // (the app's list of UK bank holidays stays hardcoded for now).
  bankHolidaysIncludedInAllowance Boolean @default(true)

  // Recurring blackout periods, computed fresh every year (never need
  // re-adding) — an alternative to ExtraBlackoutPeriod below for the two
  // common seasonal cases. Defaults here exactly match Galleywood's
  // original hardcoded behaviour (2 weeks pre-Christmas, 1 week
  // pre-Easter), so nothing changes for the existing business.
  preChristmasBlackoutEnabled Boolean @default(true)
  preChristmasBlackoutWeeks   Int     @default(2)
  preEasterBlackoutEnabled    Boolean @default(true)
  preEasterBlackoutWeeks      Int     @default(1)

  // Alternating Saturday teams (two rotating groups of named staff, shown
  // on the Calendar) — a niche feature most businesses won't use, so it
  // defaults off for new organizations. NOTE: this replaces a feature that
  // used to be hardcoded with Galleywood's real staff names; Galleywood's
  // row needs its own values re-entered via Settings after this migration
  // (see the deploy notes) rather than being auto-populated here, the same
  // way ExtraBlackoutPeriod's Christmas/Easter dates were handled earlier.
  saturdayTeamsEnabled   Boolean   @default(false)
  saturdayTeamAnchorDate DateTime? @db.Date
  saturdayTeamANames     String    @default("")
  saturdayTeamBNames     String    @default("")

  users            User[]
  leaveRequests    LeaveRequest[]    @relation("OrgLeaveRequests")
  extraClosedDates ExtraClosedDate[] @relation("OrgExtraClosedDates")
  staffRotas       StaffRota[]       @relation("OrgStaffRotas")
  overtimeEntries  OvertimeEntry[]   @relation("OrgOvertimeEntries")
  blackoutPeriods  ExtraBlackoutPeriod[] @relation("OrgBlackoutPeriods")

  @@map("organizations")
}

model User {
  id     String @id @default(cuid())
  name   String
  email  String @unique

  passwordHash String?

  isManager Boolean @default(false)

  // Cross-business access, separate from isManager (which only grants
  // manager rights within one's own organization) — for managing business
  // accounts platform-wide (Settings has no equivalent; this is granted
  // via a one-off script, not through the app itself, since it's a rare,
  // highly-privileged action).
  isPlatformAdmin Boolean @default(false)

  // If true, this account's own leave requests are wiped clean automatically
  // every time it's signed into — used for a public "try it out" demo login
  // that never accumulates real/permanent data.
  isDemo Boolean @default(false)

  allowanceAnnualHours Float @default(200)

  startDate DateTime? @db.Date

  // Every user belongs to exactly one organization. onDelete: Cascade so
  // deleting an organization (e.g. a test/abandoned business account via
  // the admin area) cleanly removes every user in it too, rather than
  // failing on a foreign key or leaving orphans.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequests   LeaveRequest[] @relation("UserLeaveRequests")
  decidedRequests LeaveRequest[] @relation("DecidedByUser")
  loginTokens     LoginToken[]
  overtimeEntries OvertimeEntry[] @relation("UserOvertimeEntries")
  rota            StaffRota?

  @@map("users")
}

model LeaveRequest {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  hours Float
  notes String?

  // Annual leave (counts against the person's allowance, goes through the
  // usual pending/approve workflow) or sick leave (manager-logged directly
  // via the Calendar, always immediately "approved", never touches anyone's
  // annual leave balance).
  type LeaveType @default(annual)

  // True only for a sick leave entry logged without confirming a real end
  // date yet (the "not sure how long they'll be off" case) — cleared
  // automatically the next time it's edited via Team & Approvals. Lets
  // Reports and Team & Approvals flag entries that might be silently
  // making a month's hours look wrong until someone finalizes them.
  openEnded Boolean @default(false)

  // Who's covering this leave, as a JSON object shaped like one of:
  //   { "type": "staff", "userId": "...", "name": "..." }
  //   { "type": "external", "name": "..." }
  // This is the default that applies to the whole leave period.
  coverName Json?

  // Per-day overrides ("YYYY-MM-DD" -> same shape as coverName above), for
  // when cover is set for just one day within a multi-day leave rather than
  // the whole period. A day present here takes priority over coverName for
  // that specific date.
  coverNameByDate Json?

  status LeaveStatus @default(pending)

  // Every leave request belongs to exactly one organization.
  organizationId String
  organization   Organization @relation("OrgLeaveRequests", fields: [organizationId], references: [id], onDelete: Cascade)

  submittedAt DateTime  @default(now())
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?     @relation("DecidedByUser", fields: [decidedById], references: [id])

  @@index([userId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([organizationId])
  @@map("leave_requests")
}

// A custom closed date belongs to exactly one organization; the primary
// key is the pair (organizationId, date) rather than date alone, so two
// different organizations can each have their own entry for the same date
// without colliding — a plain single-column `date` primary key couldn't
// support that once there's more than one organization.
model ExtraClosedDate {
  date  DateTime @db.Date
  label String

  organizationId String
  organization   Organization @relation("OrgExtraClosedDates", fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, date])
  @@map("extra_closed_dates")
}

model LoginToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@map("login_tokens")
}

model StaffRota {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sundayHours    Float @default(0)
  mondayHours    Float @default(7.5)
  tuesdayHours   Float @default(7.5)
  wednesdayHours Float @default(7.5)
  thursdayHours  Float @default(7.5)
  fridayHours    Float @default(7.5)
  saturdayHours  Float @default(4)

  organizationId String
  organization   Organization @relation("OrgStaffRotas", fields: [organizationId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@map("staff_rotas")
}

// A named date range a business wants to grey out on the Calendar as a
// "no leave requests, please" period (not a closure — the business is
// still open, staff still work) — fully custom per organization, e.g. a
// retail business's peak season. Unlike the old hardcoded pre-Christmas/
// pre-Easter periods this replaces, these are literal one-off date ranges
// (like ExtraClosedDate) rather than a rule that recomputes every year, so
// a business re-adds next year's blackout periods when the time comes.
model ExtraBlackoutPeriod {
  id        String   @id @default(cuid())
  label     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  organizationId String
  organization   Organization @relation("OrgBlackoutPeriods", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("extra_blackout_periods")
}

// Extra hours worked beyond the rota, self-logged by whoever's clicking on
// the Calendar — always immediately recorded (no approval workflow), and
// intentionally separate from LeaveRequest since this is hours *worked*,
// not an absence.
model OvertimeEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserOvertimeEntries", fields: [userId], references: [id], onDelete: Cascade)

  date  DateTime @db.Date
  hours Float
  notes String?

  organizationId String
  organization   Organization @relation("OrgOvertimeEntries", fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([date])
  @@map("overtime_entries")
}