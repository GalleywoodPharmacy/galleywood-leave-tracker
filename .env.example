# Postgres connection string from Supabase or Neon.
# Supabase: Project Settings -> Database -> Connection string (URI, use the "pooled" one for DATABASE_URL
#           if offered, and the direct one for DIRECT_URL).
# Neon: Dashboard -> Connection Details.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Only needed if your provider gives you a separate non-pooled URL for migrations.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Resend (transactional email)
RESEND_API_KEY=""
EMAIL_FROM="Galleywood Pharmacy <leave@your-domain.com>"

# Protects the weekly-digest cron endpoint. Generate with: openssl rand -hex 24
# Set the same value in your Vercel project's Cron settings if prompted.
CRON_SECRET=""

# One-time seed of the first manager account — see prisma/seed.ts.
# You can remove these from .env after the first successful `npm run db:seed`.
SEED_MANAGER_NAME="Manager Name"
SEED_MANAGER_EMAIL="manager@example.com"
SEED_MANAGER_PASSWORD="choose-a-strong-password"
